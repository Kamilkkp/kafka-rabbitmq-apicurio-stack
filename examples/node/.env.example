# Kafka on the local Compose stack (localhost:9092).
CDC_KAFKA_BROKERS=localhost:9092
CDC_KAFKA_GROUP_ID=cdc-consumer-local
CDC_SCHEMA_REGISTRY_URL=http://localhost:8081
CDC_KAFKA_CONCURRENCY=4

# Service-owned PostgreSQL. pg-boss installs its schema here.
CDC_JOB_DATABASE_URL=postgres://postgres:postgres@localhost:5435/consumer
CDC_JOB_CONCURRENCY=20
CDC_JOB_RETRY_LIMIT=100
CDC_JOB_RETRY_DELAY_SECONDS=5
CDC_JOB_RETRY_DELAY_MAX_SECONDS=1800

# This run only: enqueue Kafka from offset zero before live consumption.
# CDC_KAFKA_REPLAY=true
