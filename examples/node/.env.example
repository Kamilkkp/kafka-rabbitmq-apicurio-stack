# Kafka on the local Compose stack (localhost:9092).
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=cdc-consumer-local
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=cdc-consumer
KAFKA_SASL_PASSWORD=admin
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONCURRENCY=4

# Service-owned PostgreSQL. pg-boss installs its schema here.
JOB_DATABASE_URL=postgres://postgres:postgres@localhost:5435/consumer
JOB_CONCURRENCY=20
JOB_RETRY_LIMIT=100
JOB_RETRY_DELAY_SECONDS=5
JOB_RETRY_DELAY_MAX_SECONDS=1800

# This run only: enqueue Kafka from offset zero before live consumption.
# KAFKA_REPLAY=true
