# Kafka on the local Compose stack (localhost:9092).
CDC_KAFKA_BROKERS=localhost:9092
CDC_KAFKA_GROUP_ID=cdc-consumer-local
CDC_APICURIO_URL=http://localhost:8081
CDC_SALES_TOPIC=sales.cdc
CDC_WAREHOUSE_TOPIC=warehouse.cdc

# Live changes arrive over RabbitMQ; Kafka is only used for the startup replay.
CDC_RABBITMQ_URL=amqp://admin:admin@localhost:5672/
CDC_RABBITMQ_EXCHANGE=cdc.events
# Queue name prefix; each subscriber binds <prefix>.<source.table>.
CDC_RABBITMQ_QUEUE=cdc-consumer
CDC_RABBITMQ_PREFETCH=10

# This run only: replay compacted Kafka topics at startup, then switch to
# RabbitMQ. RabbitMQ delivery waits until the replay finishes.
# CDC_KAFKA_REPLAY=true
