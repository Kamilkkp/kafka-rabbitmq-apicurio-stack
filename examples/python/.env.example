# Kafka + Apicurio on the local CDC stack (see repo root README).
CDC_KAFKA_BROKERS=localhost:9092
CDC_KAFKA_GROUP_ID=example-python-cdc-consumer
CDC_APICURIO_URL=http://localhost:8081
CDC_SALES_TOPIC=sales.cdc
CDC_WAREHOUSE_TOPIC=warehouse.cdc

# Optional: subscribe with a regex instead of the two compacted topics.
# CDC_KAFKA_TOPIC_PATTERN=^(sales|warehouse)\.cdc$

# Optional: comma-separated topics to seek to offset 0 on assign.
# CDC_SEEK_TO_BEGINNING=sales.cdc,warehouse.cdc

# Optional: pull at most N messages then exit (see README).
# CDC_ONESHOT=1
# CDC_ONESHOT_MAX=5
