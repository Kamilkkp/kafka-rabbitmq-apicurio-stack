# Kafka + Confluent Schema Registry on the local CDC stack (see repo root README).
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=example-python-cdc-consumer
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=cdc-consumer
KAFKA_SASL_PASSWORD=admin
SCHEMA_REGISTRY_URL=http://localhost:8081

# Optional: subscribe with a regex instead of the default per-table list.
# KAFKA_TOPIC_PATTERN=^(sales|warehouse)\.public\.

# Optional: comma-separated topics to seek to offset 0 on assign.
# SEEK_TO_BEGINNING=sales.public.customers,sales.public.orders

# Optional: pull at most N messages then exit (see README).
# ONESHOT=1
# ONESHOT_MAX=5
