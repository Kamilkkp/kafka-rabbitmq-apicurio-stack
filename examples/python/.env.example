# Kafka + Confluent Schema Registry on the local CDC stack (see repo root README).
CDC_KAFKA_BROKERS=localhost:9092
CDC_KAFKA_GROUP_ID=example-python-cdc-consumer
CDC_SCHEMA_REGISTRY_URL=http://localhost:8081

# Optional: subscribe with a regex instead of the default per-table list.
# CDC_KAFKA_TOPIC_PATTERN=^(sales|warehouse)\.public\.

# Optional: comma-separated topics to seek to offset 0 on assign.
# CDC_SEEK_TO_BEGINNING=sales.public.customers,sales.public.orders

# Optional: pull at most N messages then exit (see README).
# CDC_ONESHOT=1
# CDC_ONESHOT_MAX=5
