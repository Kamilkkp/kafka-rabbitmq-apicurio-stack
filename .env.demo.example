# Local demo: copy to .env, then start infrastructure + sample databases:
# docker compose -f compose.yaml -f compose.demo.yaml up --build -d
#
# Demo passwords are for this sample only.

STACK_NAME=cdc-stack
NETWORK_NAME=cdc-stack-network
KAFKA_VOLUME_NAME=cdc-stack-kafka-data
SALES_VOLUME_NAME=cdc-stack-sales-data
WAREHOUSE_VOLUME_NAME=cdc-stack-warehouse-data
CONSUMER_VOLUME_NAME=cdc-stack-consumer-data

KAFKA_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

KAFKA_ADMIN_USER=admin
KAFKA_ADMIN_PASSWORD=admin
KAFKA_CONNECT_USER=connect
KAFKA_CONNECT_PASSWORD=admin
KAFKA_SCHEMA_REGISTRY_USER=schema-registry
KAFKA_SCHEMA_REGISTRY_PASSWORD=admin
KAFKA_KAFBAT_USER=kafbat
KAFKA_KAFBAT_PASSWORD=admin
KAFKA_CONSUMER_USER=cdc-consumer
KAFKA_CONSUMER_PASSWORD=admin

CONNECT_GROUP_ID=cdc-connect
CONNECT_CONFIG_TOPIC=cdc.connect-configs
CONNECT_OFFSET_TOPIC=cdc.connect-offsets
CONNECT_STATUS_TOPIC=cdc.connect-statuses

SALES_CONNECTOR_NAME=sales-postgres
SALES_DATABASE_HOSTNAME=postgres-sales
SALES_DATABASE_PORT=5432
SALES_DATABASE_DBNAME=sales
SALES_DATABASE_USER=debezium
SALES_DATABASE_PASSWORD=admin
SALES_TOPIC_PREFIX=sales
SALES_SLOT_NAME=sales_debezium
SALES_PUBLICATION_NAME=sales_debezium_pub
SALES_SCHEMA_HISTORY_TOPIC=sales.schema-history
SALES_SCHEMA_INCLUDE_LIST=public

WAREHOUSE_CONNECTOR_NAME=warehouse-postgres
WAREHOUSE_DATABASE_HOSTNAME=postgres-warehouse
WAREHOUSE_DATABASE_PORT=5432
WAREHOUSE_DATABASE_DBNAME=warehouse
WAREHOUSE_DATABASE_USER=debezium
WAREHOUSE_DATABASE_PASSWORD=admin
WAREHOUSE_TOPIC_PREFIX=warehouse
WAREHOUSE_SLOT_NAME=warehouse_debezium
WAREHOUSE_PUBLICATION_NAME=warehouse_debezium_pub
WAREHOUSE_SCHEMA_HISTORY_TOPIC=warehouse.schema-history
WAREHOUSE_SCHEMA_INCLUDE_LIST=public

KAFBAT_USER=admin
KAFBAT_PASSWORD=admin
KAFBAT_CLUSTER_NAME=cdc

KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
CONNECT_HEAP_OPTS=-Xms256m -Xmx768m
SCHEMA_REGISTRY_HEAP_OPTS=-Xms128m -Xmx384m
KAFBAT_JAVA_OPTS=-Xms128m -Xmx256m
