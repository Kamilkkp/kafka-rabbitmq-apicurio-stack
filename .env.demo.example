# Local demo: copy to .env, then start infrastructure + sample databases:
# docker compose -f compose.yaml -f compose.demo.yaml up --build -d
#
# Demo passwords are for this sample only.

CDC_STACK_NAME=cdc-stack
CDC_NETWORK_NAME=cdc-stack-network
CDC_KAFKA_VOLUME_NAME=cdc-stack-kafka-data
CDC_RABBITMQ_VOLUME_NAME=cdc-stack-rabbitmq-data
CDC_SALES_VOLUME_NAME=cdc-stack-sales-data
CDC_WAREHOUSE_VOLUME_NAME=cdc-stack-warehouse-data

CDC_KAFKA_ADVERTISED_HOST=localhost
CDC_KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

CDC_CONNECT_GROUP_ID=cdc-connect
CDC_CONNECT_CONFIG_TOPIC=cdc.connect-configs
CDC_CONNECT_OFFSET_TOPIC=cdc.connect-offsets
CDC_CONNECT_STATUS_TOPIC=cdc.connect-statuses

CDC_SALES_CONNECTOR_NAME=sales-postgres
CDC_SALES_DATABASE_HOSTNAME=postgres-sales
CDC_SALES_DATABASE_PORT=5432
CDC_SALES_DATABASE_DBNAME=sales
CDC_SALES_DATABASE_USER=debezium
CDC_SALES_DATABASE_PASSWORD=admin
CDC_SALES_TOPIC_PREFIX=sales
CDC_SALES_SLOT_NAME=sales_debezium
CDC_SALES_PUBLICATION_NAME=sales_debezium_pub
CDC_SALES_SCHEMA_HISTORY_TOPIC=sales.schema-history
CDC_SALES_SCHEMA_INCLUDE_LIST=public

CDC_WAREHOUSE_CONNECTOR_NAME=warehouse-postgres
CDC_WAREHOUSE_DATABASE_HOSTNAME=postgres-warehouse
CDC_WAREHOUSE_DATABASE_PORT=5432
CDC_WAREHOUSE_DATABASE_DBNAME=warehouse
CDC_WAREHOUSE_DATABASE_USER=debezium
CDC_WAREHOUSE_DATABASE_PASSWORD=admin
CDC_WAREHOUSE_TOPIC_PREFIX=warehouse
CDC_WAREHOUSE_SLOT_NAME=warehouse_debezium
CDC_WAREHOUSE_PUBLICATION_NAME=warehouse_debezium_pub
CDC_WAREHOUSE_SCHEMA_HISTORY_TOPIC=warehouse.schema-history
CDC_WAREHOUSE_SCHEMA_INCLUDE_LIST=public

CDC_RABBITMQ_USER=admin
CDC_RABBITMQ_PASSWORD=admin
CDC_RABBITMQ_EXCHANGE=cdc.events
CDC_RABBITMQ_CONSUMER_GROUP=cdc-rabbitmq-bridge

CDC_KAFBAT_USER=admin
CDC_KAFBAT_PASSWORD=admin
CDC_KAFBAT_CLUSTER_NAME=cdc

CDC_KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
CDC_KAFKA_CONNECT_HEAP_OPTS=-Xms256m -Xmx768m
CDC_APICURIO_JAVA_OPTS=-Xms128m -Xmx384m
CDC_KAFBAT_JAVA_OPTS=-Xms128m -Xmx256m
