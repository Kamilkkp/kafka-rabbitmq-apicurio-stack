{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "plugin.name": "pgoutput",
  "publication.autocreate.mode": "disabled",
  "snapshot.mode": "initial",
  "tombstones.on.delete": "true",
  "decimal.handling.mode": "precise",
  "time.precision.mode": "adaptive_time_microseconds",
  "schema.name.adjustment.mode": "avro",
  "transforms": "Reroute,Collapse,TableHeader",
  "transforms.Reroute.type": "io.debezium.transforms.ByLogicalTableRouter",
  "transforms.Reroute.topic.regex": "(.*)",
  "transforms.Reroute.topic.replacement": "$1",
  "transforms.Reroute.key.enforce.uniqueness": "true",
  "transforms.Reroute.key.field.name": "__source_table",
  "transforms.Reroute.key.field.regex": "(.*)",
  "transforms.Reroute.key.field.replacement": "$1",
  "transforms.Collapse.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.TableHeader.type": "org.apache.kafka.connect.transforms.HeaderFrom$Key",
  "transforms.TableHeader.fields": "__source_table",
  "transforms.TableHeader.headers": "cdc_table",
  "transforms.TableHeader.operation": "copy",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
  "schema.history.internal.kafka.topic": "cdc.schema-history",
  "topic.creation.default.replication.factor": "1",
  "topic.creation.default.partitions": "1",
  "topic.creation.default.cleanup.policy": "compact",
  "topic.creation.default.segment.ms": "3600000",
  "topic.creation.default.min.cleanable.dirty.ratio": "0.1",
  "topic.creation.default.delete.retention.ms": "86400000",
  "key.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "key.converter.apicurio.registry.auto-register": "true",
  "key.converter.apicurio.registry.dereference-schema": "true",
  "key.converter.apicurio.registry.headers.enabled": "false",
  "key.converter.apicurio.registry.as-confluent": "true",
  "key.converter.apicurio.registry.artifact-resolver-strategy": "io.apicurio.registry.serde.avro.strategy.QualifiedRecordIdStrategy",
  "key.converter.apicurio.registry.artifact.group-id": "default",
  "value.converter": "io.apicurio.registry.utils.converter.AvroConverter",
  "value.converter.apicurio.registry.auto-register": "true",
  "value.converter.apicurio.registry.dereference-schema": "true",
  "value.converter.apicurio.registry.headers.enabled": "false",
  "value.converter.apicurio.registry.as-confluent": "true",
  "value.converter.apicurio.registry.artifact-resolver-strategy": "io.apicurio.registry.serde.avro.strategy.QualifiedRecordIdStrategy",
  "value.converter.apicurio.registry.artifact.group-id": "default"
}
